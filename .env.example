# Copy to .env for local development. Never commit .env.
# On your host (Render, Railway, ...) set these as environment variables instead.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string, including the database name, e.g.
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/alan-luby?retryWrites=true&w=majority
MONGODB_URI=

# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Origin(s) of the website allowed to call the API with cookies, comma-separated, no trailing slash.
# The existing frontend dev server runs on port 3000.
FRONTEND_URL=http://localhost:3000

# Used only by `npm run seed` to create the first admin account. Password: at least 12 characters.
# You can remove them from the environment after seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional. Cookie SameSite policy: "lax" (default) when the website proxies /api to this server (recommended),
# "none" when the website calls this API on a different domain directly (requires NODE_ENV=production / HTTPS).
# COOKIE_SAMESITE=lax

# Optional. Number of reverse proxies in front of the app (for correct client IPs and secure cookies). Default 1.
# TRUST_PROXY=1
